# =============================================================================
# Konfigurasi Musyami API — salin file ini menjadi .env lalu isi nilai asli
# =============================================================================

# --- Server ---
PORT=3001
HOST=0.0.0.0

# --- Keamanan ---
# Ganti dengan kunci rahasia acak yang kuat (endpoint tulis butuh header x-admin-key)
ADMIN_KEY=ganti-dengan-kunci-rahasia-anda

# --- CORS ---
# Alamat frontend Next.js yang diizinkan mengakses API
CORS_ORIGIN=http://localhost:3000

# --- Penyimpanan ---
# Di dalam Docker container, path ini sudah di-mount ke volume bernama
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# --- SMTP (opsional, untuk kirim email kontak) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=email-anda@contoh.com
