# Dockerfile khusus Fly.io: sama dengan Dockerfile utama, tapi volume yang
# di-mount dimiliki root, jadi folder data dibereskan dulu lalu aplikasi
# dijalankan sebagai user non-root (node).

# --- Stage 1: Build ---
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build
RUN cp -r src/seeds dist/seeds

# --- Stage 2: Runtime ---
FROM node:20-alpine AS runner
LABEL maintainer="Musyami" \
      description="Musyami Portfolio REST API (Fly.io)"
WORKDIR /app

# wget untuk healthcheck, su-exec untuk menurunkan hak akses ke user node
RUN apk add --no-cache wget su-exec

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=builder /app/dist ./dist

ENV PORT=3001
EXPOSE ${PORT}

# Mulai sebagai root hanya untuk memberi izin ke volume, lalu jalan sebagai node
CMD ["sh", "-c", "mkdir -p /app/data/uploads && chown -R node:node /app/data && exec su-exec node node dist/index.js"]
